{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregoryyy/gefly/data/schema/poh-values.schema.json",
  "title": "Gefly selected flight-manual values",
  "description": "Individual cited flight-manual values for one aircraft manifest (R-DATA-1, R-DATA-2, R-FID-3): airspeed calibration points, stall speeds and performance points with conditions. Not a copy of a table or figure and not a flight model. Citations resolve against the source register of the manifest named in 'manifest'. The definitions citation, citations, status and status_rules must stay identical to aircraft-manifest.schema.json (checked by utils/test_validate_manifest.py). utils/validate_manifest.py implements this subset of JSON Schema plus cross-reference, conversion and ordering rules.",
  "type": "object",
  "required": [
    "schema_version", "values_id", "values_version", "status", "fidelity", "manifest",
    "extraction", "airspeed_calibration", "stall_speeds", "takeoff_distance",
    "landing_distance", "climb", "corrections", "not_extracted", "pending", "prepared"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "values_id": {"type": "string", "pattern": "^gefly\\.aircraft\\.[a-z0-9][a-z0-9-]*\\.poh-values$"},
    "values_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "superseded"]},
    "fidelity": {"const": "not validated"},
    "manifest": {
      "description": "Sibling manifest whose source register the citations use. 'path' is a file name in the same directory.",
      "type": "object",
      "required": ["path", "manifest_id"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"},
        "manifest_id": {"type": "string", "pattern": "^gefly\\.aircraft\\.[a-z0-9][a-z0-9-]*$"}
      }
    },
    "extraction": {"type": "string", "minLength": 1},
    "airspeed_calibration": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/calibration_series"}
    },
    "stall_speeds": {"$ref": "#/$defs/quantity_group"},
    "takeoff_distance": {"$ref": "#/$defs/quantity_group"},
    "landing_distance": {"$ref": "#/$defs/quantity_group"},
    "climb": {"$ref": "#/$defs/quantity_group"},
    "corrections": {
      "description": "The source's correction notes, summarised in the preparer's own words.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["applies_to", "summary", "citations"],
        "additionalProperties": false,
        "properties": {
          "applies_to": {"enum": ["airspeed_calibration", "stall_speeds", "takeoff_distance", "landing_distance", "climb"]},
          "summary": {"type": "string", "minLength": 1},
          "citations": {"$ref": "#/$defs/citations", "minItems": 1}
        }
      }
    },
    "not_extracted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prepared": {
      "type": "object",
      "required": ["date", "by", "from"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "by": {"type": "string", "minLength": 1},
        "from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "status": {
      "description": "R-DATA-2 value status.",
      "enum": ["sourced", "derived", "estimated", "unknown"]
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "revision", "page"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "page": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "status_rules": {
      "description": "sourced needs a page citation; derived needs a derivation; unknown needs a TODO.",
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "sourced"}}},
          "then": {"properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "derived"}}},
          "then": {"required": ["derivation"], "properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"required": ["todo"]}
        }
      ]
    },
    "reading": {
      "description": "How the value was taken from the source: printed in a table, or read off a graph.",
      "enum": ["tabulated", "read_from_chart"]
    },
    "quantity": {
      "description": "A single flight-manual value. 'condition' is required because a performance value is meaningless without it. Rate of climb uses reference 'vertical'.",
      "type": "object",
      "required": ["value", "unit", "original_unit", "condition", "status", "citations", "reading", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["m", "m/s"]},
        "original_value": {"type": ["number", "null"]},
        "original_unit": {"enum": ["ft", "kt", "ft/min"]},
        "reference": {"enum": ["IAS", "CAS", "TAS", "vertical"]},
        "condition": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "reading": {"$ref": "#/$defs/reading"},
        "conversion": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"unit": {"const": "m/s"}}},
          "then": {"required": ["reference"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["sourced", "derived", "estimated"]}}},
          "then": {
            "required": ["original_value", "conversion"],
            "properties": {"value": {"type": "number"}, "original_value": {"type": "number"}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"properties": {"value": {"type": "null"}, "original_value": {"type": "null"}}}
        }
      ]
    },
    "quantity_group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/quantity"}
    },
    "airspeed": {
      "type": "object",
      "required": ["value", "unit", "original_value", "original_unit", "reference"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "unit": {"const": "m/s"},
        "original_value": {"type": "number"},
        "original_unit": {"const": "kt"},
        "reference": {"enum": ["IAS", "CAS"]}
      }
    },
    "calibration_point": {
      "type": "object",
      "required": ["ias", "cas"],
      "additionalProperties": false,
      "properties": {
        "ias": {"allOf": [{"$ref": "#/$defs/airspeed"}, {"properties": {"reference": {"const": "IAS"}}}]},
        "cas": {"allOf": [{"$ref": "#/$defs/airspeed"}, {"properties": {"reference": {"const": "CAS"}}}]}
      }
    },
    "calibration_series": {
      "description": "Selected IAS-to-CAS points for one static source and flap setting. The validator requires strictly increasing IAS.",
      "type": "object",
      "required": [
        "static_source", "flaps_deg", "condition", "status", "citations", "reading",
        "selection", "uncertainty", "points"
      ],
      "additionalProperties": false,
      "properties": {
        "static_source": {"enum": ["normal", "alternate"]},
        "flaps_deg": {"type": "number"},
        "condition": {"type": "string", "minLength": 1},
        "status": {"enum": ["sourced", "unknown"]},
        "citations": {"$ref": "#/$defs/citations"},
        "reading": {"$ref": "#/$defs/reading"},
        "selection": {"type": "string", "minLength": 1},
        "conversion": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "points": {"type": "array", "items": {"$ref": "#/$defs/calibration_point"}},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"status": {"const": "sourced"}}},
          "then": {"required": ["conversion"], "properties": {"points": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"properties": {"points": {"const": []}}}
        }
      ]
    }
  }
}
