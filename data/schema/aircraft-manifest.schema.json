{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregoryyy/gefly/data/schema/aircraft-manifest.schema.json",
  "title": "Gefly aircraft rights/applicability manifest",
  "description": "Identifies one aircraft configuration, its source-cited limits and the rights of each source (R-AIR-1, R-DATA-1, R-DATA-2, R-FID-3). Not a flight model. utils/validate_manifest.py implements this subset of JSON Schema plus cross-reference rules.",
  "type": "object",
  "required": [
    "schema_version", "manifest_id", "manifest_version", "status", "fidelity",
    "configuration", "mass_limits", "speed_limits", "avionics", "sources",
    "not_included", "pending", "prepared"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^gefly\\.aircraft\\.[a-z0-9][a-z0-9-]*$"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "superseded"]},
    "fidelity": {"const": "not validated"},
    "configuration": {
      "type": "object",
      "required": [
        "label", "manufacturer", "model", "type_certificate", "category",
        "serial_range", "panel", "flight_manual", "engine", "propeller"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "manufacturer": {"$ref": "#/$defs/fact"},
        "model": {"$ref": "#/$defs/fact"},
        "type_certificate": {"$ref": "#/$defs/fact"},
        "category": {"$ref": "#/$defs/fact"},
        "serial_range": {
          "type": "object",
          "required": ["first", "last", "basis"],
          "additionalProperties": false,
          "properties": {
            "first": {"$ref": "#/$defs/fact"},
            "last": {"$ref": "#/$defs/fact"},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        "panel": {"$ref": "#/$defs/fact"},
        "flight_manual": {"$ref": "#/$defs/fact"},
        "engine": {
          "type": "object",
          "required": ["model", "ratings"],
          "additionalProperties": false,
          "properties": {
            "model": {"$ref": "#/$defs/fact"},
            "ratings": {"$ref": "#/$defs/quantity_group"}
          }
        },
        "propeller": {
          "type": "object",
          "required": ["model", "limits"],
          "additionalProperties": false,
          "properties": {
            "model": {"$ref": "#/$defs/fact"},
            "limits": {"$ref": "#/$defs/quantity_group"}
          }
        }
      }
    },
    "mass_limits": {"$ref": "#/$defs/quantity_group"},
    "speed_limits": {"$ref": "#/$defs/quantity_group"},
    "avionics": {
      "type": "object",
      "required": ["fit_status", "note", "items"],
      "additionalProperties": false,
      "properties": {
        "fit_status": {"enum": ["selected", "tbd"]},
        "note": {"type": "string", "minLength": 1},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/avionics_item"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "not_included": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prepared": {
      "type": "object",
      "required": ["date", "by", "from"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "by": {"type": "string", "minLength": 1},
        "from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "status": {
      "description": "R-DATA-2 value status.",
      "enum": ["sourced", "derived", "estimated", "unknown"]
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "revision", "page"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "page": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "conflict": {
      "type": "object",
      "required": ["original_value", "original_unit", "citation"],
      "additionalProperties": false,
      "properties": {
        "original_value": {"type": "number"},
        "original_unit": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "citation": {"$ref": "#/$defs/citation"}
      }
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "original_unit", "status", "citations", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["kg", "m/s", "m", "rad/s", "W"]},
        "original_value": {"type": ["number", "null"]},
        "original_unit": {"type": "string", "minLength": 1},
        "reference": {"enum": ["IAS", "CAS", "TAS"]},
        "condition": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "conversion": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"status": {"enum": ["sourced", "derived", "estimated"]}}},
          "then": {
            "required": ["original_value"],
            "properties": {"value": {"type": "number"}, "original_value": {"type": "number"}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"properties": {"value": {"type": "null"}, "original_value": {"type": "null"}}}
        }
      ]
    },
    "quantity_group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/quantity"}
    },
    "fact": {
      "type": "object",
      "required": ["value", "status", "citations"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "derivation": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"status": {"enum": ["sourced", "derived", "estimated"]}}},
          "then": {"properties": {"value": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "status_rules": {
      "description": "sourced needs a page citation; derived needs a derivation; unknown needs a TODO.",
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "sourced"}}},
          "then": {"properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "derived"}}},
          "then": {"required": ["derivation"], "properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"required": ["todo"]}
        }
      ]
    },
    "avionics_item": {
      "type": "object",
      "required": ["function", "equipment", "role", "modeled"],
      "additionalProperties": false,
      "properties": {
        "function": {"type": "string", "minLength": 1},
        "equipment": {"$ref": "#/$defs/fact"},
        "role": {"enum": ["standard", "optional"]},
        "modeled": {"enum": ["tbd", "no", "yes"]}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id", "title", "publisher", "document", "revision", "url", "accessed",
        "access_status", "applicability", "rights"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "document": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "pattern": "^https://"},
        "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "access_status": {"enum": ["read", "read_selected_pages", "not_read"]},
        "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"},
        "applicability": {"type": "string", "minLength": 1},
        "rights": {
          "type": "object",
          "required": ["holder", "basis", "redistribution", "copy_in_repository"],
          "additionalProperties": false,
          "properties": {
            "holder": {"type": "string", "minLength": 1},
            "basis": {"type": "string", "minLength": 1},
            "redistribution": {"enum": ["public_domain_us", "reference_only", "facts_only"]},
            "copy_in_repository": {"const": false}
          }
        },
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"url": {"type": "null"}}},
          "then": {"required": ["todo"]}
        }
      ]
    }
  }
}
