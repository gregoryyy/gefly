{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregoryyy/gefly/data/schema/indication-loading-values.schema.json",
  "title": "Gefly engine/fuel indications and sample loading values",
  "description": "Cited flight-manual facts for one aircraft manifest (R-DATA-1, R-DATA-2, R-AIR-1): the engine and fuel indications of the panel (gauges, counters, annunciators) with their published markings and triggers, and the flight manual's sample loading example (basic empty mass/moment of a sample airplane, station arms). Not a copy of a table or figure, not an instrument model and not a weighed aircraft. Keys of 'indications' and 'annunciators' are proposed ind field names (SCENARIO-CONTRACTS); the ind list itself is frozen there, not here. Citations resolve against the source register of the manifest named in 'manifest'. The definitions citation, citations, status and status_rules must stay identical to aircraft-manifest.schema.json, and reading to poh-values.schema.json (checked by utils/test_validate_manifest.py). utils/validate_manifest.py implements this subset of JSON Schema plus cross-reference and conversion rules.",
  "type": "object",
  "required": [
    "schema_version", "values_id", "values_version", "status", "fidelity", "manifest",
    "extraction", "indications", "annunciators", "sample_loading", "conflicts",
    "not_extracted", "pending", "prepared"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "values_id": {"type": "string", "pattern": "^gefly\\.aircraft\\.[a-z0-9][a-z0-9-]*\\.indication-loading-values$"},
    "values_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "superseded"]},
    "fidelity": {"const": "not validated"},
    "manifest": {
      "description": "Sibling manifest whose source register the citations use. 'path' is a file name in the same directory; version and SHA-256 (of the file bytes) pin the exact manifest.",
      "type": "object",
      "required": ["path", "manifest_id", "manifest_version", "manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"},
        "manifest_id": {"type": "string", "pattern": "^gefly\\.aircraft\\.[a-z0-9][a-z0-9-]*$"},
        "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the exact bytes of the manifest file."}
      }
    },
    "extraction": {"type": "string", "minLength": 1},
    "indications": {
      "description": "Gauges and counters, keyed by the proposed ind field name (unit suffix per CONTRACTS).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/indication"}
    },
    "annunciators": {
      "description": "Annunciator-panel messages, keyed by the proposed ind field name.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/annunciator"}
    },
    "sample_loading": {"$ref": "#/$defs/sample_loading"},
    "conflicts": {
      "description": "Disagreements inside the source, recorded without choosing a value.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "statements", "citations", "resolution"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Indication keys the conflict concerns; every marking with governs: true must be listed in one conflict (validator rule)."},
          "statements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "citations": {"$ref": "#/$defs/citations", "minItems": 1},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "not_extracted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prepared": {
      "type": "object",
      "required": ["date", "by", "from"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "by": {"type": "string", "minLength": 1},
        "from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "status": {
      "description": "R-DATA-2 value status.",
      "enum": ["sourced", "derived", "estimated", "unknown"]
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "revision", "page"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "page": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "status_rules": {
      "description": "sourced needs a page citation; derived needs a derivation; unknown needs a TODO.",
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "sourced"}}},
          "then": {"properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "derived"}}},
          "then": {"required": ["derivation"], "properties": {"citations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"required": ["todo"]}
        }
      ]
    },
    "reading": {
      "description": "How the value was taken from the source: printed in a table, or read off a graph.",
      "enum": ["tabulated", "read_from_chart"]
    },
    "quantity_reading": {
      "description": "Like 'reading', plus 'derived' for a value computed from other cited values.",
      "enum": ["tabulated", "read_from_chart", "derived"]
    },
    "si_unit": {
      "description": "SI storage units. 'kg*m' is a moment (mass times arm); '1' is dimensionless.",
      "enum": ["K", "Pa", "rad/s", "m^3", "m^3/s", "s", "V", "A", "m", "kg", "kg*m", "kg/m^3", "1"]
    },
    "original_unit": {
      "description": "Units as published. degF converts affinely; the validator's tables decide which pairs are allowed.",
      "enum": ["degF", "psi", "rpm", "gal", "gal/h", "inHg", "h", "s", "V", "A", "in", "lb", "lb-in/1000", "lb/gal", "1"]
    },
    "measure": {
      "description": "One published number in SI with its published value and unit.",
      "type": "object",
      "required": ["value", "unit", "original_value", "original_unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "unit": {"$ref": "#/$defs/si_unit"},
        "original_value": {"type": "number"},
        "original_unit": {"$ref": "#/$defs/original_unit"}
      }
    },
    "marking": {
      "description": "One published instrument marking. Arcs need lower and upper; a red line needs 'at'.",
      "type": "object",
      "required": ["kind", "condition", "status", "citations", "reading", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["green_arc", "yellow_arc", "white_arc", "red_line_min", "red_line_max"]},
        "lower": {"$ref": "#/$defs/measure"},
        "upper": {"$ref": "#/$defs/measure"},
        "at": {"$ref": "#/$defs/measure"},
        "condition": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "reading": {"$ref": "#/$defs/reading"},
        "uncertainty": {"type": "string", "minLength": 1},
        "conversion": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "governs": {"type": "boolean", "description": "true: decided as the governing marking where the source conflicts (see conflicts)."},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"kind": {"enum": ["green_arc", "yellow_arc", "white_arc"]}}},
          "then": {"required": ["lower", "upper"], "properties": {"at": false}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["red_line_min", "red_line_max"]}}},
          "then": {"required": ["at"], "properties": {"lower": false, "upper": false}}
        }
      ]
    },
    "scale": {
      "description": "Dial or display range of the instrument. Unknown until a source states it.",
      "type": "object",
      "required": ["status", "citations"],
      "additionalProperties": false,
      "properties": {
        "lower": {"$ref": "#/$defs/measure"},
        "upper": {"$ref": "#/$defs/measure"},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "note": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"status": {"enum": ["sourced", "derived", "estimated"]}}},
          "then": {"required": ["lower", "upper"]}
        }
      ]
    },
    "indication": {
      "description": "A gauge or counter on the panel. 'unit' is the SI unit of the proposed ind field; 'original_unit' is the unit the instrument is calibrated or marked in, omitted when the source does not state it.",
      "type": "object",
      "required": ["instrument", "panel_item", "quantity", "kind", "unit", "scale", "markings", "status", "citations"],
      "additionalProperties": false,
      "properties": {
        "instrument": {"type": "string", "minLength": 1},
        "panel_item": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "kind": {"enum": ["gauge", "counter"]},
        "unit": {"$ref": "#/$defs/si_unit"},
        "original_unit": {"$ref": "#/$defs/original_unit"},
        "scale": {"$ref": "#/$defs/scale"},
        "markings": {"type": "array", "items": {"$ref": "#/$defs/marking"}},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "serial_dependence": {"type": "string", "minLength": 1},
        "scope": {"enum": ["engine", "fuel", "engine_driven_system", "electrical"]},
        "inclusion": {"type": "string", "minLength": 1, "description": "Decision that places the field in ind (date and record)."},
        "note": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"scope": {"const": "electrical"}}, "required": ["scope"]},
          "then": {"required": ["inclusion"]}
        }
      ]
    },
    "trigger": {
      "description": "Published condition that lights an annunciator: a quantity below/above a threshold, optionally for longer than a persistence time.",
      "type": "object",
      "required": ["quantity", "comparison", "status", "citations", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "comparison": {"enum": ["below", "above", "fault"]},
        "threshold": {"$ref": "#/$defs/measure"},
        "persistence": {"$ref": "#/$defs/measure"},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "uncertainty": {"type": "string", "minLength": 1},
        "conversion": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"comparison": {"enum": ["below", "above"]}}},
          "then": {"required": ["threshold"]}
        }
      ]
    },
    "flash": {
      "description": "Published flash time after the message comes on, before it turns steady.",
      "type": "object",
      "required": ["duration", "status", "citations", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "duration": {"$ref": "#/$defs/measure"},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "uncertainty": {"type": "string", "minLength": 1},
        "conversion": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [{"$ref": "#/$defs/status_rules"}]
    },
    "annunciator": {
      "description": "One annunciator-panel message. Colour and message are facts; 'triggers' lists every published condition that lights it.",
      "type": "object",
      "required": ["message", "colour", "kind", "triggers", "flash", "status", "citations"],
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "colour": {"enum": ["red", "amber"]},
        "kind": {"enum": ["warning", "caution"]},
        "triggers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trigger"}},
        "flash": {"$ref": "#/$defs/flash"},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "serial_dependence": {"type": "string", "minLength": 1},
        "scope": {"enum": ["engine", "fuel", "engine_driven_system", "electrical"]},
        "inclusion": {"type": "string", "minLength": 1, "description": "Decision that places the field in ind (date and record)."},
        "note": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"scope": {"const": "electrical"}}, "required": ["scope"]},
          "then": {"required": ["inclusion"]}
        },
        {
          "if": {"properties": {"colour": {"const": "red"}}},
          "then": {"properties": {"kind": {"const": "warning"}}}
        },
        {
          "if": {"properties": {"colour": {"const": "amber"}}},
          "then": {"properties": {"kind": {"const": "caution"}}}
        }
      ]
    },
    "quantity": {
      "description": "A single cited value with its condition. No airspeed reference applies to these units.",
      "type": "object",
      "required": ["value", "unit", "original_unit", "condition", "status", "citations", "reading", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"$ref": "#/$defs/si_unit"},
        "original_value": {"type": ["number", "null"]},
        "original_unit": {"$ref": "#/$defs/original_unit"},
        "condition": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "reading": {"$ref": "#/$defs/quantity_reading"},
        "conversion": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "uncertainty_si": {"type": "number", "description": "Absolute bound in the SI unit; the validator uses it as the tolerance for recomputed derived values."},
        "note": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/status_rules"},
        {
          "if": {"properties": {"status": {"enum": ["sourced", "derived", "estimated"]}}},
          "then": {
            "required": ["original_value", "conversion"],
            "properties": {"value": {"type": "number"}, "original_value": {"type": "number"}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {"properties": {"value": {"type": "null"}, "original_value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "derived"}}},
          "then": {"required": ["uncertainty_si"], "properties": {"reading": {"const": "derived"}}}
        },
        {
          "if": {"properties": {"reading": {"const": "derived"}}},
          "then": {"properties": {"status": {"const": "derived"}}}
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": ["value", "status", "citations"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "citations": {"$ref": "#/$defs/citations"},
        "derivation": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "todo": {"type": "string", "minLength": 1}
      },
      "allOf": [{"$ref": "#/$defs/status_rules"}]
    },
    "sample_loading": {
      "description": "The flight manual's sample loading example. 'nature' is fixed: these are a sample airplane's numbers, not a weighed or delivered aircraft (GAPS Q23 b).",
      "type": "object",
      "required": ["nature", "datum", "values"],
      "additionalProperties": false,
      "properties": {
        "nature": {"const": "sample: flight-manual example airplane, not a weighed aircraft"},
        "datum": {"$ref": "#/$defs/fact"},
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/quantity"}
        }
      }
    }
  }
}
